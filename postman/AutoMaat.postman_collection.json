{
  "info": {
    "name": "AutoMaat API",
    "description": "Volledige endpoint-collectie voor de AutoMaat web-API. Authenticatie via Keycloak (OAuth2.0 Authorization Code) is op collectie-niveau ingesteld; vraag eerst een token op via 'Get New Access Token' en vul je client secret in de collectie-variabele. Wachtwoord testgebruikers: geheim.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "oauth2",
    "oauth2": [
      { "key": "grant_type", "value": "authorization_code", "type": "string" },
      { "key": "authUrl", "value": "{{keycloakUrl}}/realms/automaat/protocol/openid-connect/auth", "type": "string" },
      { "key": "accessTokenUrl", "value": "{{keycloakUrl}}/realms/automaat/protocol/openid-connect/token", "type": "string" },
      { "key": "clientId", "value": "automaat-api", "type": "string" },
      { "key": "clientSecret", "value": "{{clientSecret}}", "type": "string" },
      { "key": "scope", "value": "openid", "type": "string" },
      { "key": "redirect_uri", "value": "https://oauth.pstmn.io/v1/callback", "type": "string" },
      { "key": "tokenName", "value": "automaat-token", "type": "string" },
      { "key": "addTokenTo", "value": "header", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "keycloakUrl", "value": "http://localhost:9090" },
    { "key": "clientSecret", "value": "" }
  ],
  "item": [
    {
      "name": "Customers",
      "item": [
        {
          "name": "Get all customers",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/customers", "host": ["{{baseUrl}}"], "path": ["customers"] } }
        },
        {
          "name": "Get customer by id",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/customers/1", "host": ["{{baseUrl}}"], "path": ["customers", "1"] } }
        },
        {
          "name": "Create customer",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Henk de Vries\",\n  \"phoneNumber\": \"0612345678\",\n  \"email\": \"henk@example.com\"\n}" },
            "url": { "raw": "{{baseUrl}}/customers", "host": ["{{baseUrl}}"], "path": ["customers"] }
          }
        },
        {
          "name": "Update customer (PUT)",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Henk de Vries\",\n  \"phoneNumber\": \"0611111111\",\n  \"email\": \"henk@example.com\"\n}" },
            "url": { "raw": "{{baseUrl}}/customers/1", "host": ["{{baseUrl}}"], "path": ["customers", "1"] }
          }
        },
        {
          "name": "Patch customer",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"phoneNumber\": \"0622222222\"\n}" },
            "url": { "raw": "{{baseUrl}}/customers/1", "host": ["{{baseUrl}}"], "path": ["customers", "1"] }
          }
        },
        {
          "name": "Delete customer",
          "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/customers/1", "host": ["{{baseUrl}}"], "path": ["customers", "1"] } }
        }
      ]
    },
    {
      "name": "Cars",
