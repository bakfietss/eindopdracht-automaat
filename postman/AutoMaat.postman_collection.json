          "name": "Get car by id",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/cars/1", "host": ["{{baseUrl}}"], "path": ["cars", "1"] } }
        },
        {
          "name": "Create car",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"licensePlate\": \"AB-123-C\",\n  \"brand\": \"Volkswagen\",\n  \"model\": \"Golf\",\n  \"buildYear\": 2018,\n  \"customerId\": 1\n}" },
            "url": { "raw": "{{baseUrl}}/cars", "host": ["{{baseUrl}}"], "path": ["cars"] }
          }
        },
        {
          "name": "Update car (PUT)",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"licensePlate\": \"AB-123-C\",\n  \"brand\": \"Volkswagen\",\n  \"model\": \"Golf GTI\",\n  \"buildYear\": 2019,\n  \"customerId\": 1\n}" },
            "url": { "raw": "{{baseUrl}}/cars/1", "host": ["{{baseUrl}}"], "path": ["cars", "1"] }
          }
        },
        {
          "name": "Patch car",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"model\": \"Golf GTE\"\n}" },
            "url": { "raw": "{{baseUrl}}/cars/1", "host": ["{{baseUrl}}"], "path": ["cars", "1"] }
          }
        },
        {
          "name": "Upload autopapieren (PDF)",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [ { "key": "file", "type": "file", "src": [] } ] },
            "url": { "raw": "{{baseUrl}}/cars/1/document", "host": ["{{baseUrl}}"], "path": ["cars", "1", "document"] }
          }
        },
        {
          "name": "Download autopapieren (PDF)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/cars/1/document", "host": ["{{baseUrl}}"], "path": ["cars", "1", "document"] } }
        },
        {
          "name": "Delete car",
          "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/cars/1", "host": ["{{baseUrl}}"], "path": ["cars", "1"] } }
        }
      ]
    },
